# Frontend environment variables — copy to frontend/.env and set your backend URL.
# These are inlined into the build at compile time (public, not secret).

REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_AGENT_PORTAL_URL=https://agents.hidmc.in/auth/login
WDS_SOCKET_PORT=3000
ENABLE_HEALTH_CHECK=false
