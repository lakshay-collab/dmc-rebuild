# Backend environment variables — copy to backend/.env and fill in real values.
# Do NOT commit the real .env (it is gitignored).

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=hidmc

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Sembark lead integration
SEMBARK_API_BASE=
SEMBARK_SERVICE_TOKEN=
SEMBARK_DESTINATION_TOKEN=

# Auth
JWT_SECRET=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# SMTP (transactional email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=HI DMC
SMTP_FROM_EMAIL=
